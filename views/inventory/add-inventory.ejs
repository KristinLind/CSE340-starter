<section class="inv-form-card">
    <h1>
        <%= title %>
    </h1>

    <%- messages() %>

        <% if (errors && errors.length) { %>
            <ul class="notice">
                <% errors.forEach(e=> { %>
                    <li>
                        <%= e.msg %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

                <form action="/inv/add-inventory" method="post">
                    <div class="inv-form-grid">
                        <div class="form-field">
                            <label>Classification</label>
                            <%- classificationList %>
                        </div>

                        <div class="form-field">
                            <label for="inv_make">Make</label>
                            <input type="text" id="inv_make" name="inv_make" required value="<%= inv_make %>"
                                placeholder="e.g. Ford">
                        </div>

                        <div class="form-field">
                            <label for="inv_model">Model</label>
                            <input type="text" id="inv_model" name="inv_model" required value="<%= inv_model %>"
                                placeholder="e.g. F-150">
                        </div>

                        <div class="form-field">
                            <label for="inv_year">Year</label>
                            <input type="text" id="inv_year" name="inv_year" required pattern="^[0-9]{4}$"
                                value="<%= inv_year %>" placeholder="YYYY">
                        </div>

                        <div class="form-field form-field-full">
                            <label for="inv_description">Description</label>
                            <textarea id="inv_description" name="inv_description"
                                required><%= inv_description %></textarea>
                        </div>

                        <!-- CRITERIA 9 FIX: Fields are now visible so paths can be overridden -->
                        <div class="form-field">
                            <label for="inv_image">Image Path</label>
                            <input type="text" id="inv_image" name="inv_image" value="<%= inv_image %>" required>
                        </div>

                        <div class="form-field">
                            <label for="inv_thumbnail">Thumbnail Path</label>
                            <input type="text" id="inv_thumbnail" name="inv_thumbnail" value="<%= inv_thumbnail %>"
                                required>
                        </div>

                        <div class="form-field">
                            <label for="inv_price">Price</label>
                            <!-- min="0" prevents negative numbers in the browser -->
                            <input type="number" id="inv_price" name="inv_price" required value="<%= inv_price %>"
                                min="0" step="0.01">
                        </div>

                        <div class="form-field">
                            <label for="inv_miles">Miles</label>
                            <!-- min="0" prevents negative numbers in the browser -->
                            <input type="number" id="inv_miles" name="inv_miles" required value="<%= inv_miles %>"
                                min="0">
                        </div>

                        <div class="form-field">
                            <label for="inv_color">Color</label>
                            <input type="text" id="inv_color" name="inv_color" required value="<%= inv_color %>"
                                placeholder="e.g. Blue">
                        </div>
                    </div>

                    <div class="inv-form-actions">
                        <button type="submit">Add Vehicle</button>
                    </div>
                </form>
</section>