<section class="inv-form-card">
    <h1>
        <%= title %>
    </h1>
    <% if (flash && flash.notice.length) { %>
        <div class="notice">
            <%= flash.notice[0] %>
        </div>
        <% } %>
    
            <% if (flash && flash.success.length) { %>
                <div class="flash flash--success">
                    <%= flash.success[0] %>
                </div>
                <% } %>
    
                    <% if (flash && flash.error.length) { %>
                        <div class="flash flash--error">
                            <%= flash.error[0] %>
                        </div>
                        <% } %>


        <% if (errors && errors.length) { %>
            <ul class="notice">
                <% errors.forEach(e=> { %>
                    <li>
                        <%= e.msg %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

                <p>Are you sure you want to delete this vehicle? This cannot be undone.</p>

                <ul>
                    <li><strong>Vehicle:</strong>
                        <%= inv_make %>
                            <%= inv_model %>
                    </li>
                    <li><strong>Year:</strong>
                        <%= inv_year %>
                    </li>
                    <li><strong>Price:</strong>
                        <%= inv_price %>
                    </li>
                </ul>

                <form action="/inv/delete" method="post">
                    <input type="hidden" name="inv_id" value="<%= inv_id %>">
                    <button type="submit">Confirm Delete</button>
                </form>
</section>