<header id="top-header">
    <div class="header-inner">
        <button id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
            ☰
        </button>
        <span class="siteName">
            <a href="/" title="Return to home page">CSE Motors</a>
        </span>
        <div id="tools" class="account">
            <% if (locals.loggedin) { %>
                <a title="Click to manage account" href="/account/">
                    Welcome <%= locals.accountData.account_firstname %>
                </a>
                <a href="/account/logout" class="logout-btn" title="Click to log out">Logout</a>
                <% } else { %>
                    <a title="Click to log in" href="/account/login">My Account</a>
                    <% } %>
        </div>
    </div>
</header>


